# ============================================================================
#  khdecorators.uk — environment
#
#  Copy to .env.local for development, and set the same names in the host for
#  production. Nothing in here is a secret except SMTP_PASS.
#
#  `npm run check:launch` fails while any of the required ones are missing.
# ============================================================================

# ---------------------------------------------------------------------------
# The site's own address. Drives canonical tags, the sitemap and Open Graph.
# No trailing slash.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://khdecorators.uk


# ---------------------------------------------------------------------------
# GOOGLE ADS CONVERSIONS — read ADS-MIGRATION.md before filling these in.
#
# The tag itself (AW-11172797357) is hard-coded in src/lib/conversions.ts,
# because it is already live on the current site and an unset variable would
# silently take the tracking off.
#
# These three are the `send_to` values of the EXISTING conversion actions in
# Kenny's Ads account. Format: AW-11172797357/<label>
#
# Do NOT create new conversion actions to generate these. A new action starts
# its learning from zero and smart bidding gets worse for weeks. Find the
# existing ones — Goals → Conversions → Summary, click the action, "Tag setup",
# "Use Google Tag Manager"/"Install the tag yourself" — and copy the label out.
#
# Until they are set, the site records nothing and logs a warning in dev.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADS_CONVERSION_FORM=
NEXT_PUBLIC_ADS_CONVERSION_CALL=
NEXT_PUBLIC_ADS_CONVERSION_EMAIL=


# ---------------------------------------------------------------------------
# GA4, for behaviour. Optional and free. Ads tracking does not depend on it.
# Format: G-XXXXXXXXXX
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=


# ---------------------------------------------------------------------------
# ENQUIRY DELIVERY
#
# The form posts to a route handler in this app, which emails the enquiry via
# Kenny's own Outlook mailbox. No form provider, no third-party account, no
# subscription — see LAUNCH.md §4 for generating the app password.
#
# If these are unset the form does NOT pretend to work: the visitor is told to
# ring, and the enquiry is written to the server log in full so it can be
# recovered. Never leave it that way in production.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=khdecorators@outlook.com
SMTP_PASS=

# Where enquiries are delivered. Defaults to the address published on the site.
ENQUIRY_TO=khdecorators@outlook.com
