# Copy to .env.local for local work, or set these in the host's dashboard.
# All three are optional to get the site running. The first is required before launch.

# The live origin, no trailing slash. Drives canonical tags, sitemap.xml, Open
# Graph and the "url" in the structured data. Without it these all point at
# localhost.
#
# It must match whatever the current site canonicalises to — www or the bare
# domain. Changing the canonical host on cutover is the one migration mistake
# that cannot be quietly undone. See MIGRATION.md §3.
NEXT_PUBLIC_SITE_URL=https://mcdonaldpaintingcontractors.co.uk

# Where a submitted enquiry is POSTed as JSON. A free Zapier or Make hook, a
# Google Apps Script, or an email relay — anything that will accept a POST.
#
# Leave it unset and enquiries are written to the server log instead. They are
# not lost, but nobody is told about them. The phone number is the primary route
# in and always will be.
# ENQUIRY_WEBHOOK_URL=

# GA4 measurement ID. Nothing analytics-related loads without it, so a preview
# build sends no data anywhere and Lighthouse measures the site rather than the
# tag.
#
# The two events worth watching are capability_statement_download and
# enquiry_type_selected. Those are the ones that show whether the site is doing
# the job the rebuild was for; pageviews are not.
# NEXT_PUBLIC_GA_ID=
