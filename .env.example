# Copy to .env.local for local work, or set these in your host's dashboard.
# Both are optional to get the site running; the first is required before launch.

# The live origin, no trailing slash. Drives canonical tags, sitemap.xml,
# Open Graph and the JSON-LD "url". Without it these all point at localhost.
NEXT_PUBLIC_SITE_URL=https://example.co.uk

# Where a submitted contact form is POSTed as JSON. Leave unset and enquiries
# are only written to the server log — the phone number still works either way.
# ENQUIRY_WEBHOOK_URL=

# Set to 1 for a staging build that shows the client what is still missing:
# the brief for every empty photo slot, and the unconfirmed village list.
# Leave unset in production.
# NEXT_PUBLIC_SHOW_PHOTO_BRIEFS=1
