# ---------------------------------------------------------------------------
# The Paint Man — environment variables
# Copy to .env.local for development. Set the same keys in Railway → Variables.
# Every service used is free at the volumes this site will see.
# ---------------------------------------------------------------------------

# Public site URL, no trailing slash. Used for metadata, OG images and sitemap.
NEXT_PUBLIC_SITE_URL=https://thepaintman.co.uk

# Resend — free tier covers 3,000 emails/month, 100/day. resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries and booking requests are delivered.
LEAD_TO_EMAIL=hello@thepaintman.co.uk

# Verified sending identity in Resend. Must be on a domain verified there.
# Falls back to Resend's onboarding@resend.dev sandbox address when unset.
LEAD_FROM_EMAIL="The Paint Man <enquiries@thepaintman.co.uk>"

# Tawk.to live chat — free plan. Dashboard → Administration → Chat Widget.
# Widget URL looks like https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>
# Leave both blank to disable chat entirely (no script is loaded).
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
